# Copy to .env and fill in. .env is gitignored — never commit real values.
# In GitHub Actions these are set as repository secrets instead (Settings > Secrets and variables > Actions).

# Notion internal integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxx

# Workouts database ID (the 32-char hex in the database URL, dashes optional)
NOTION_WORKOUTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=xxx
# Long-lived refresh token from the one-time OAuth grant (scope: activity:read_all). See README.
STRAVA_REFRESH_TOKEN=xxx

# Optional: how many days back to look when the Workouts DB has no Strava rows yet (default 30)
STRAVA_BACKFILL_DAYS=30
