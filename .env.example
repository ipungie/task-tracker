# Copy to .env and fill in. .env is gitignored — never commit real values.
# In GitHub Actions these are set as repository secrets instead (Settings > Secrets and variables > Actions).

# Notion internal integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxx

# Workouts database ID (the 32-char hex in the database URL, dashes optional)
NOTION_WORKOUTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=xxx
# Long-lived refresh token from the one-time OAuth grant (scope: activity:read_all). See README.
STRAVA_REFRESH_TOKEN=xxx

# Optional: how many days back to look when the Workouts DB has no Strava rows yet (default 30)
STRAVA_BACKFILL_DAYS=30

# Optional: path to the committed Hevy "Export & Backup Data" CSV (default data/hevy.csv)
HEVY_CSV_PATH=data/hevy.csv

# Optional overrides for dashboard_to_notion.py. Defaults are baked into the script (the IDs in
# CLAUDE.md / README.md); set these only to point it at a different workspace.
NOTION_MAIN_HUB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TASKS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BODY_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- notion_to_gcal.py (one-way Notion -> Google Calendar) ---
# Events database ID, created by setup_notion.py (put the printed id here). Required for the sync.
NOTION_EVENTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Google Cloud service-account key, the whole JSON on one line. Share the target
# calendar with the service account's email ("Make changes to events").
GCAL_SA_JSON={"type":"service_account","project_id":"...","private_key":"...", "...":"..."}
# The calendar's ID from Google Calendar settings — usually your gmail address. Never "primary".
GCAL_CALENDAR_ID=you@gmail.com
# Optional: IANA timezone for meetings that have a time but no offset (default Asia/Jakarta)
GCAL_TZ=Asia/Jakarta
